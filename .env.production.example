# Vercel Production environment template — copy the values into the Vercel
# dashboard rather than committing a real .env.production file.
STOREFRONT_USERNAME=foodpapa1

# Optional public browser override. The SDK already knows the canonical
# production Checkout MFE URL.
NEXT_PUBLIC_CHECKOUT_MFE_URL=https://nova-checkout-ruby.vercel.app/embed/index.global.js

# Optional public browser override. The SDK already knows the canonical
# production Profile MFE URL.
NEXT_PUBLIC_PROFILE_MFE_URL=https://profile-mfe-opal.vercel.app/embed/index.global.js

# Do not add an API base here. The Order SDK owns the canonical Ordrz API
# base; the Demo uses its same-origin BFF for browser-safe production calls.
