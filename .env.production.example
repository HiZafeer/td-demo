# Vercel Production environment template — copy the values into the Vercel
# dashboard rather than committing a real .env.production file.
STOREFRONT_USERNAME=foodpapa1

# Public browser configuration: use the deployed Checkout MFE origin exactly.
NEXT_PUBLIC_CHECKOUT_MFE_URL=https://YOUR-CHECKOUT-MFE-DOMAIN/embed/index.global.js
NEXT_PUBLIC_CHECKOUT_API_BASE_URL=https://YOUR-CHECKOUT-MFE-DOMAIN/api/checkout
