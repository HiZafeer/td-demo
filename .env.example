# Confirmed FoodPapa1 storefront used by the Nova host at
# foodpapa1.live.ordrz.store.
STOREFRONT_USERNAME=foodpapa1

# Browser-visible MFE endpoints for local development. These must use the
# NEXT_PUBLIC_ prefix because CheckoutMount runs in the browser.
NEXT_PUBLIC_CHECKOUT_MFE_URL=http://localhost:3001/embed/index.global.js
NEXT_PUBLIC_CHECKOUT_API_BASE_URL=http://localhost:3001/api/checkout
