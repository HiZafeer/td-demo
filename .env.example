# Confirmed FoodPapa1 storefront used by the Nova host at
# foodpapa1.live.ordrz.store.
STOREFRONT_USERNAME=foodpapa1

# Optional browser-visible MFE endpoint overrides for local development. The
# SDK automatically uses localhost:3001/3002 locally and its canonical
# production deployments elsewhere.
NEXT_PUBLIC_CHECKOUT_MFE_URL=http://localhost:3001/embed/index.global.js
NEXT_PUBLIC_PROFILE_MFE_URL=http://localhost:3002/embed/index.global.js

# Optional browser-safe Stripe publishable key. Never place a secret key here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
